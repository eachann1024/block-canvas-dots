{
  "app": "blockmd",
  "schema_version": 1,
  "id": "block-canvas-dots",
  "name": {
    "zh": "编辑器背景",
    "en": "Editor Background"
  },
  "version": "1.2.1",
  "author": "eachann1024",
  "repo": "eachann1024/block-canvas-dots",
  "summary": {
    "zh": "为笔记铺上与行高对齐的点阵或方格，增加对比度，稳定追踪每一行",
    "en": "Line-aligned dot or grid background for notes, adding contrast to track each line"
  },
  "entry": {
    "command": [
      "python3",
      "-u",
      "main.py"
    ]
  },
  "permissions": [
    "storage",
    "ui:settings"
  ],
  "permission_reasons": {
    "storage": {
      "zh": "保存背景样式、对比度与对齐方式设置",
      "en": "Save editor background style, contrast, and alignment preferences"
    },
    "ui:settings": {
      "zh": "应用并切换编辑器点阵或方格背景",
      "en": "Apply and toggle editor dot or grid backgrounds"
    }
  },
  "surfaces": [
